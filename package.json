{
  "name": "travel-wonhae-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "server": "./gradlew bootRun",
    "server:mysql": "./gradlew bootRun --args='--spring.profiles.active=mysql'",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "npm run build:web && ./gradlew bootJar && node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/react": "~19.3.0",
    "expo": "~58.0.19",
    "expo-crypto": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.19",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "typescript": "~6.0.3"
  }
}
