# 비밀 키는 서버에서만 읽습니다. 실제 값은 .env에 설정하세요.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# 한국수출입은행 현재환율 API 인증키 (영수증의 "오늘 환율" 버튼). 없으면 환율은 직접 입력합니다.
KOREAEXIM_API_KEY=
# MySQL 8. DB가 없으면 travel_wonhae를 새로 만듭니다.
DB_URL=jdbc:mysql://localhost:3306/travel_wonhae?createDatabaseIfNotExist=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=
PORT=8787
# 실기기에서는 localhost 대신 개발 컴퓨터의 LAN IP를 사용합니다.
EXPO_PUBLIC_API_URL=http://localhost:8787
# 지도 타일용 Mapbox 공개 토큰(pk.로 시작). 앱 번들에 포함되므로 비밀 토큰(sk.)은 넣지 마세요.
EXPO_PUBLIC_MAPBOX_TOKEN=
# 웹에서 API를 호출할 수 있는 origin (쉼표 구분)
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
